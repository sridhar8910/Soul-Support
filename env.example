# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
POSTGRES_DB=soulsupport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2828
DATABASE_URL=postgres://postgres:2828@postgres:5432/soulsupport

# Redis Configuration (for Channels/WebSocket)
REDIS_URL=redis://redis:6379/0

# TURN Server Configuration
TURN_SHARED_SECRET=generate-with-openssl-rand-hex-32
TURN_REALM=soulsupport.local
TURN_SERVER=turn.soulsupport.local
TURN_PORT=3478

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=python.nexnoratech@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=python.nexnoratech@gmail.com
USE_CONSOLE_EMAIL=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# Static and Media Files
STATIC_ROOT=/app/static
MEDIA_ROOT=/app/media

